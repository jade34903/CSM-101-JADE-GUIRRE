    ) = guirre_student_data

    # Calculate total quiz score
    total_quiz_score = sum(guirre_score)

    # Calculate quiz average
    quiz_average = total_quiz_score / len(guirre_score)

    # Calculate final score
    final_score = (quiz_average + guirre_project + guirre_attendance) / 3

    # Determine status
    if final_score >= guirre_average:
        status = "PASSED"
